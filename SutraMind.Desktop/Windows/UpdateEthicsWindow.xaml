<Window x:Class="SutraMind.Desktop.Windows.UpdateEthicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update ethics status" Height="420" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F4EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Update Ethics Review" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <TextBlock x:Name="IecLabel" FontWeight="SemiBold" FontSize="14" />
            <TextBlock x:Name="CurrentStatusLabel" Margin="0,6,0,0" Foreground="#687873" />
            <TextBlock Text="New status" Margin="0,20,0,4" />
            <ComboBox x:Name="StatusCombo" Padding="8,6">
                <ComboBoxItem Content="Pending" />
                <ComboBoxItem Content="Submitted" />
                <ComboBoxItem Content="Approved" />
                <ComboBoxItem Content="Rejected" />
                <ComboBoxItem Content="Expired" />
            </ComboBox>
            <TextBlock Text="Approval date (yyyy-MM-dd)" Margin="0,12,0,4" />
            <TextBox x:Name="ApprovalDateBox" Padding="8,6" />
            <TextBlock Text="Expiry date (yyyy-MM-dd)" Margin="0,12,0,4" />
            <TextBox x:Name="ExpiryDateBox" Padding="8,6" />
            <TextBlock Text="Remarks" Margin="0,12,0,4" />
            <TextBox x:Name="RemarksBox" Padding="8,6" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="#A45D2B" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fill Dummy Data" Width="120" Margin="0,0,16,0" Click="FillDummyData_Click" Foreground="#276C65" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button Content="Update" Width="110" IsDefault="True" Click="Update_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
