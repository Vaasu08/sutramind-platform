<Window x:Class="SutraMind.Desktop.Windows.EnrollParticipantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enroll participant" Height="520" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F4EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="New participant enrollment" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <TextBlock Text="Participant code" Margin="0,0,0,4" />
            <TextBox x:Name="CodeTextBox" Padding="8,6" />
            <TextBlock Text="Full name" Margin="0,12,0,4" />
            <TextBox x:Name="NameTextBox" Padding="8,6" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel Width="120" Margin="0,0,12,0">
                    <TextBlock Text="Age" Margin="0,0,0,4" />
                    <TextBox x:Name="AgeTextBox" Padding="8,6" />
                </StackPanel>
                <StackPanel Width="120">
                    <TextBlock Text="Gender (M/F)" Margin="0,0,0,4" />
                    <TextBox x:Name="GenderTextBox" Padding="8,6" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Randomization ID (optional)" Margin="0,12,0,4" />
            <TextBox x:Name="RandomizationTextBox" Padding="8,6" />
            <TextBlock Text="Prakriti" Margin="0,12,0,4" />
            <ComboBox x:Name="PrakritiCombo" Padding="8,6" DisplayMemberPath="LabelEn" SelectedValuePath="Code" />
            <TextBlock Text="Agni" Margin="0,12,0,4" />
            <ComboBox x:Name="AgniCombo" Padding="8,6" DisplayMemberPath="LabelEn" SelectedValuePath="Code" />
            <TextBlock Text="Bala" Margin="0,12,0,4" />
            <ComboBox x:Name="BalaCombo" Padding="8,6" DisplayMemberPath="LabelEn" SelectedValuePath="Code" />
            <TextBlock Text="Satva" Margin="0,12,0,4" />
            <ComboBox x:Name="SatvaCombo" Padding="8,6" DisplayMemberPath="LabelEn" SelectedValuePath="Code" />
            <TextBlock x:Name="ErrorText" Foreground="#A45D2B" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fill Dummy Data" Width="120" Margin="0,0,16,0" Click="FillDummyData_Click" Foreground="#276C65" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button Content="Enroll" Width="110" IsDefault="True" Click="Enroll_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
