<Window x:Class="SutraMind.Desktop.Windows.ParticipantDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Participant detail" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F4EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Participant Detail" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <Border Padding="16" Background="White" BorderBrush="#E1DED7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="CodeText" FontSize="18" FontWeight="Bold" Foreground="#174A45" />
                    <TextBlock x:Name="DemographicText" Margin="0,6,0,0" FontSize="13" Foreground="#687873" />
                    <TextBlock x:Name="DiagnosisText" Margin="0,4,0,0" FontSize="13" />
                    <TextBlock x:Name="RandomizationText" Margin="0,4,0,0" FontSize="12" Foreground="#687873" />
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Padding="16" Background="#E9F1EE" BorderBrush="#D1E2DB" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Ayurveda Baseline" FontSize="15" FontWeight="SemiBold" Foreground="#174A45" />
                    <TextBlock x:Name="PrakritiText" Margin="0,10,0,0" />
                    <TextBlock x:Name="AgniText" Margin="0,4,0,0" />
                    <TextBlock x:Name="BalaText" Margin="0,4,0,0" />
                    <TextBlock x:Name="SatvaText" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="#A45D2B" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="90" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button x:Name="WithdrawButton" Content="Withdraw" Width="110" Click="Withdraw_Click" Style="{StaticResource SecondaryActionButtonStyle}" Foreground="#A44F3E" />
            <Button x:Name="CompleteButton" Content="Mark completed" Width="130" Margin="8,0,0,0" Click="Complete_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
