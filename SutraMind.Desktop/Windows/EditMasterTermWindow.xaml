<Window x:Class="SutraMind.Desktop.Windows.EditMasterTermWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master term" Height="440" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F4EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="Add Master Term" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <TextBlock Text="Category" Margin="0,0,0,4" />
            <TextBox x:Name="CategoryBox" Padding="8,6" />
            <TextBlock Text="Code" Margin="0,12,0,4" />
            <TextBox x:Name="CodeBox" Padding="8,6" />
            <TextBlock Text="English label" Margin="0,12,0,4" />
            <TextBox x:Name="LabelEnBox" Padding="8,6" />
            <TextBlock Text="Hindi label" Margin="0,12,0,4" />
            <TextBox x:Name="LabelHiBox" Padding="8,6" />
            <TextBlock Text="Modern mapping (optional)" Margin="0,12,0,4" />
            <TextBox x:Name="ModernMappingBox" Padding="8,6" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel Width="100" Margin="0,0,12,0">
                    <TextBlock Text="Sort order" Margin="0,0,0,4" />
                    <TextBox x:Name="SortOrderBox" Padding="8,6" Text="1" />
                </StackPanel>
                <CheckBox x:Name="ActiveCheck" Content="Active" VerticalAlignment="Bottom" Margin="0,0,0,6" IsChecked="True" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#A45D2B" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button x:Name="SaveButton" Content="Add term" Width="110" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
