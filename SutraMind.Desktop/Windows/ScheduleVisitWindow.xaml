<Window x:Class="SutraMind.Desktop.Windows.ScheduleVisitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule visit" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F4EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Schedule a study visit" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <TextBlock Text="Participant" Margin="0,0,0,4" />
            <ComboBox x:Name="ParticipantCombo" Padding="8,6" DisplayMemberPath="Code" />
            <TextBlock Text="Visit number" Margin="0,12,0,4" />
            <TextBox x:Name="VisitNumberTextBox" Padding="8,6" Text="3" />
            <TextBlock Text="Scheduled date (yyyy-MM-dd)" Margin="0,12,0,4" />
            <TextBox x:Name="DateTextBox" Padding="8,6" />
            <TextBlock x:Name="ErrorText" Foreground="#A45D2B" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fill Dummy Data" Width="120" Margin="0,0,16,0" Click="FillDummyData_Click" Foreground="#276C65" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button Content="Schedule" Width="110" IsDefault="True" Click="Schedule_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
