<Window x:Class="SutraMind.Desktop.Windows.RecordCrfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Case Report Form" Height="640" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F7F4EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Case Report Form" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="VisitHeader" Margin="0,6,0,0" FontSize="12" Foreground="#687873" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="VITALS" FontSize="11" FontWeight="Bold" Foreground="#8CB4AA" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel Width="110" Margin="0,0,12,0">
                        <TextBlock Text="Systolic BP" Margin="0,0,0,4" />
                        <TextBox x:Name="SystolicBox" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Width="110" Margin="0,0,12,0">
                        <TextBlock Text="Diastolic BP" Margin="0,0,0,4" />
                        <TextBox x:Name="DiastolicBox" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="Pulse (bpm)" Margin="0,0,0,4" />
                        <TextBox x:Name="PulseBox" Padding="8,6" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Width="110" Margin="0,0,12,0">
                        <TextBlock Text="Weight (kg)" Margin="0,0,0,4" />
                        <TextBox x:Name="WeightBox" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="Temp (°C)" Margin="0,0,0,4" />
                        <TextBox x:Name="TempBox" Padding="8,6" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="AYURVEDA ASSESSMENT" FontSize="11" FontWeight="Bold" Foreground="#8CB4AA" Margin="0,4,0,8" />
                <TextBlock Text="Agni" Margin="0,0,0,4" />
                <ComboBox x:Name="AgniCombo" Padding="8,6" DisplayMemberPath="LabelEn" SelectedValuePath="Code" />
                <TextBlock Text="Bala" Margin="0,12,0,4" />
                <ComboBox x:Name="BalaCombo" Padding="8,6" DisplayMemberPath="LabelEn" SelectedValuePath="Code" />
                <TextBlock Text="Symptoms" Margin="0,12,0,4" />
                <TextBox x:Name="SymptomsBox" Padding="8,6" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />

                <TextBlock Text="MEDICINE" FontSize="11" FontWeight="Bold" Foreground="#8CB4AA" Margin="0,16,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel Width="160" Margin="0,0,12,0">
                        <TextBlock Text="Dose" Margin="0,0,0,4" />
                        <TextBox x:Name="DoseBox" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Width="160">
                        <TextBlock Text="Frequency" Margin="0,0,0,4" />
                        <TextBox x:Name="FrequencyBox" Padding="8,6" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Compliance" Margin="0,0,0,4" />
                <TextBox x:Name="ComplianceBox" Padding="8,6" />

                <TextBlock Text="COMPLETION" FontSize="11" FontWeight="Bold" Foreground="#8CB4AA" Margin="0,16,0,8" />
                <TextBlock Text="Remarks" Margin="0,0,0,4" />
                <TextBox x:Name="RemarksBox" Padding="8,6" Height="50" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Text="Status" Margin="0,12,0,4" />
                <ComboBox x:Name="StatusCombo" Padding="8,6">
                    <ComboBoxItem Content="Draft" IsSelected="True" />
                    <ComboBoxItem Content="Completed" />
                </ComboBox>
                <TextBlock x:Name="ErrorText" Foreground="#A45D2B" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fill Dummy Data" Width="120" Margin="0,0,16,0" Click="FillDummyData_Click" Foreground="#276C65" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" />
            <Button Content="Save CRF" Width="110" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
