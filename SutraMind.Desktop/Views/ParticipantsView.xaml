<UserControl x:Class="SutraMind.Desktop.Views.ParticipantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Enroll participant" Command="{Binding EnrollCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Width="180" Margin="0" ToolTip="{Binding EnrollTooltip}" />
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center" />
                <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Width="100" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource ClinicalCardBorderStyle}">
            <DataGrid ItemsSource="{Binding Participants}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SUBJECT" Binding="{Binding Code}" Width="90" />
                    <DataGridTextColumn Header="AGE / SEX" Binding="{Binding Demographic}" Width="85" />
                    <DataGridTextColumn Header="RANDOMIZATION" Binding="{Binding Randomization}" Width="110" />
                    <DataGridTextColumn Header="PRAKRITI" Binding="{Binding Prakriti}" Width="*" />
                    <DataGridTextColumn Header="AGNI" Binding="{Binding Agni}" Width="110" />
                    <DataGridTextColumn Header="BALA" Binding="{Binding Bala}" Width="100" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="125" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
