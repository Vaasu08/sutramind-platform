<UserControl x:Class="SutraMind.Desktop.Views.DataQueriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Answer" Command="{Binding AnswerQueryCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Width="90" Margin="8,0,0,0" />
                <Button Content="Close" Command="{Binding CloseQueryCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Width="80" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Raise query" Command="{Binding RaiseQueryCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Width="120" />
                <CheckBox Content="Show open queries only" IsChecked="{Binding OpenOnly}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource ClinicalCardBorderStyle}">
            <DataGrid ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SUBJECT" Binding="{Binding SubjectCode}" Width="100" />
                    <DataGridTextColumn Header="FIELD" Binding="{Binding FieldName}" Width="90" />
                    <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="RAISED" Binding="{Binding RaisedAtUtc, StringFormat=g}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
