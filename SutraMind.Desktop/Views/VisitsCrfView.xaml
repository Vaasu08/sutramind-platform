<UserControl x:Class="SutraMind.Desktop.Views.VisitsCrfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Schedule visit" Command="{Binding ScheduleVisitCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Width="140" />
            <Button Content="Record CRF" Command="{Binding RecordCrfCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Width="120" Margin="8,0,0,0" />
            <Button Content="Complete visit" Command="{Binding CompleteVisitCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Width="130" Margin="8,0,0,0" />
        </StackPanel>
        <Border Style="{StaticResource ClinicalCardBorderStyle}">
            <DataGrid ItemsSource="{Binding Visits}" SelectedItem="{Binding SelectedVisit}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SUBJECT" Binding="{Binding ParticipantCode}" Width="100" />
                    <DataGridTextColumn Header="VISIT" Binding="{Binding VisitLabel}" Width="140" />
                    <DataGridTextColumn Header="SCHEDULED" Binding="{Binding ScheduledDate, StringFormat=d}" Width="110" />
                    <DataGridTextColumn Header="CRF STATUS" Binding="{Binding CrfStatus}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
