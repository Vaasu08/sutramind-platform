<UserControl x:Class="SutraMind.Desktop.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ClinicalCardBorderStyle}">
        <DataGrid ItemsSource="{Binding Terms}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120" />
                <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="80" />
                <DataGridTextColumn Header="ENGLISH" Binding="{Binding LabelEn}" Width="*" />
                <DataGridTextColumn Header="HINDI" Binding="{Binding LabelHi}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</UserControl>
