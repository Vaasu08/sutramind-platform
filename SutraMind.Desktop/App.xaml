<Application x:Class="SutraMind.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SutraMind.Desktop.Views"
             xmlns:viewModels="clr-namespace:SutraMind.Desktop.ViewModels"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ClinicalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:StudiesViewModel}">
                <views:StudiesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ParticipantsViewModel}">
                <views:ParticipantsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:VisitsCrfViewModel}">
                <views:VisitsCrfView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:DataQueriesViewModel}">
                <views:DataQueriesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:EthicsReviewViewModel}">
                <views:EthicsReviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MasterDataViewModel}">
                <views:MasterDataView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
